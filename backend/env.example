# Copy to backend/.env for native (non-Docker) runs. backend/.env is git-ignored — never commit secrets.
NADIEN_DATABASE_URL=postgresql+psycopg://nadien:nadien@localhost:5432/nadien
# Quick local trial without PostgreSQL:
# NADIEN_DATABASE_URL=sqlite:///./nadien.db
NADIEN_UTIL_YELLOW_PCT=60
NADIEN_UTIL_RED_PCT=80
NADIEN_PLANNING_THRESHOLD_PCT=80

# Backup before every Observium/RANCID/Oxidized/config sync (utilization-only runs are not backed up).
# Default dir: nadien-backups/ next to the SQLite file, ./backups for PostgreSQL.
# NADIEN_BACKUP_DIR=/root/nadien-backups
NADIEN_BACKUP_KEEP=15
NADIEN_BACKUP_BEFORE_SYNC=true

# Observium API (Profile -> API tokens -> Manage). Prefer a READ-ONLY token restricted to this server's IP.
NADIEN_OBSERVIUM_URL=http://172.17.42.136
NADIEN_OBSERVIUM_TOKEN=
# ...or HTTP basic auth with an Observium user (used only when no token is set).
# Wrap the password in SINGLE quotes so characters like # @ ! $ are taken literally:
# NADIEN_OBSERVIUM_USER=
# NADIEN_OBSERVIUM_PASSWORD='...'
NADIEN_OBSERVIUM_VERIFY_TLS=true
# POP code from hostname (first regex group): JKT-P-01 -> JKT
NADIEN_OBSERVIUM_POP_REGEX=^([A-Za-z]{3,4})[-_.]
# CDP fills in Cisco devices without LLDP; LLDP wins when both see the same port
NADIEN_OBSERVIUM_INCLUDE_CDP=true

# Utilization history (daily peaks) from Observium's RRD files.
# api   = graph.php JSON with the login above, nothing else needed (older days are peaks of 2-hour averages)
# ssh   = exact daily MAX via rrdtool on the Observium server (settings below)
# local = same, when NADIEN runs on the Observium server itself
NADIEN_OBSERVIUM_RRD_SOURCE=api
NADIEN_OBSERVIUM_GRAPH_WORKERS=6
# For ssh: a READ-ONLY account that can read the RRD dir and run rrdtool; host = NADIEN_OBSERVIUM_URL's host by default.
# NADIEN_OBSERVIUM_SSH_USER=nadien-ro
# NADIEN_OBSERVIUM_SSH_KEY_FILE=/root/.ssh/nadien_observium
# NADIEN_OBSERVIUM_SSH_PASSWORD='...'
# NADIEN_OBSERVIUM_SSH_HOST=172.17.42.136
# NADIEN_OBSERVIUM_SSH_PORT=22
# Unknown host keys are rejected (ssh-keyscan 172.17.42.136 >> /root/.ssh/known_hosts):
# NADIEN_OBSERVIUM_SSH_KNOWN_HOSTS=/root/.ssh/known_hosts
NADIEN_OBSERVIUM_RRD_PATH=/opt/observium/rrd
# Days of samples used for the growth trend that drives exhaustion forecasts (7/30/90 are always shown)
NADIEN_TREND_WINDOW_DAYS=90

# RANCID archive used by Observium (device configs; Observium's API does not expose them).
# Option A — SFTP to the Observium server with a read-only SSH account + key:
# NADIEN_RANCID_SSH_HOST=172.17.42.136
# NADIEN_RANCID_SSH_USER=nadien-ro
# NADIEN_RANCID_SSH_KEY_FILE=/root/.ssh/nadien_rancid
# NADIEN_RANCID_REMOTE_PATH=/opt/observium/rancid
# Host key must be known (ssh-keyscan 172.17.42.136 >> /root/.ssh/known_hosts) or listed here:
# NADIEN_RANCID_SSH_KNOWN_HOSTS=/root/.ssh/known_hosts
# Option B — folder mounted locally (NFS/SMB/sshfs) or NADIEN running on the Observium box:
# NADIEN_RANCID_PATH=/opt/observium/rancid

# RANCID repositories via gitweb (all repos: CSR-*, METRO-*, ROUTER-*, BNG-*, OLT-*). Backup config source,
# and the only source for devices Observium does not monitor (cell-site routers in CSR-* repos).
NADIEN_GITWEB_URL=http://172.17.12.232/gitweb/
# NADIEN_GITWEB_USER=
# NADIEN_GITWEB_PASSWORD='...'
# Repos to skip, JSON list: NADIEN_GITWEB_EXCLUDE_REPOS=["OLT-FIBERHOME"]
# Daily update of changed files (HH:MM in NADIEN_SCHEDULE_TIMEZONE); empty = off.
NADIEN_GITWEB_DAILY_AT=02:30
NADIEN_SCHEDULE_TIMEZONE=Asia/Jakarta
# false where an external scheduler (Kubernetes CronJob / cron) triggers syncs instead
NADIEN_SCHEDULER_ENABLED=true

# Busiest links / port occupancy (Capacity > Hotspot)
NADIEN_HOTSPOT_WARNING_PCT=70
NADIEN_HOTSPOT_CRITICAL_PCT=90

# Performance (production): read-model cache and DB connection pool per worker process
# NADIEN_CACHE_TTL_S=60
# NADIEN_DB_POOL_SIZE=10
# NADIEN_DB_MAX_OVERFLOW=20

# Oxidized REST API (alternative config source)
# NADIEN_OXIDIZED_URL=http://oxidized.example:8888
# NADIEN_OXIDIZED_USER=
# NADIEN_OXIDIZED_PASSWORD=
