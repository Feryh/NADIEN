# Copy to backend/.env for native (non-Docker) runs. backend/.env is git-ignored — never commit secrets.
NADIEN_DATABASE_URL=postgresql+psycopg://nadien:nadien@localhost:5432/nadien
# Quick local trial without PostgreSQL:
# NADIEN_DATABASE_URL=sqlite:///./nadien.db
NADIEN_UTIL_YELLOW_PCT=60
NADIEN_UTIL_RED_PCT=80
NADIEN_PLANNING_THRESHOLD_PCT=80

# Observium API (Profile -> API tokens -> Manage). Prefer a READ-ONLY token restricted to this server's IP.
NADIEN_OBSERVIUM_URL=http://172.17.42.136
NADIEN_OBSERVIUM_TOKEN=
# ...or HTTP basic auth with an Observium user (used only when no token is set):
# NADIEN_OBSERVIUM_USER=
# NADIEN_OBSERVIUM_PASSWORD=
NADIEN_OBSERVIUM_VERIFY_TLS=true
# POP code from hostname (first regex group): JKT-P-01 -> JKT
NADIEN_OBSERVIUM_POP_REGEX=^([A-Za-z]{3,4})[-_.]
NADIEN_OBSERVIUM_INCLUDE_CDP=false

# RANCID archive used by Observium (device configs; Observium's API does not expose them).
# Option A — SFTP to the Observium server with a read-only SSH account + key:
# NADIEN_RANCID_SSH_HOST=172.17.42.136
# NADIEN_RANCID_SSH_USER=nadien-ro
# NADIEN_RANCID_SSH_KEY_FILE=/root/.ssh/nadien_rancid
# NADIEN_RANCID_REMOTE_PATH=/opt/observium/rancid
# Host key must be known (ssh-keyscan 172.17.42.136 >> /root/.ssh/known_hosts) or listed here:
# NADIEN_RANCID_SSH_KNOWN_HOSTS=/root/.ssh/known_hosts
# Option B — folder mounted locally (NFS/SMB/sshfs) or NADIEN running on the Observium box:
# NADIEN_RANCID_PATH=/opt/observium/rancid

# Oxidized REST API (alternative config source)
# NADIEN_OXIDIZED_URL=http://oxidized.example:8888
# NADIEN_OXIDIZED_USER=
# NADIEN_OXIDIZED_PASSWORD=
